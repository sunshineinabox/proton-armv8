From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Thu, 22 Oct 2026 10:25:02 -0700
Subject: [PATCH 1/2] build: target ARMv8.0 on arm64

Build the arm64 Wine PE and Unix sides with -march=armv8-a, and FEX with TUNE_CPU=generic, so CPUs without LSE atomics can run them.
---
 Makefile.in | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Makefile.in b/Makefile.in
index 5e477c7f..bf58af4f 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -53,8 +53,8 @@ REDIST_DIR := ./redist
 
 i386_CFLAGS    := -mstackrealign -march=nocona -mtune=core-avx2 -mfpmath=sse
 x86_64_CFLAGS  := -mcmodel=small -march=nocona -mtune=core-avx2 -mfpmath=sse
-aarch64_CFLAGS := -march=armv8.2-a -mtune=cortex-x3
-arm64ec_CFLAGS := -march=armv8.2-a -mtune=cortex-x3
+aarch64_CFLAGS := -march=armv8-a
+arm64ec_CFLAGS := -march=armv8-a
 
 CFLAGS  = -O2 -fwrapv -fno-strict-aliasing
 CFLAGS += -ggdb -ffunction-sections -fdata-sections -fno-omit-frame-pointer
@@ -851,7 +851,7 @@ $(OBJ)/.vkd3d-proton-post-source:
 ifneq ($(findstring aarch64,$(unix_ARCHS)),)
 FEX_COMMON_CMAKE_ARGS = \
   -DENABLE_FEXCORE_PROFILER=True -DCMAKE_BUILD_TYPE=Release -DENABLE_LTO=False \
-  -DBUILD_TESTING=False -DTUNE_CPU=none -DRANGES_NATIVE=OFF \
+  -DBUILD_TESTING=False -DTUNE_CPU=generic -DRANGES_NATIVE=OFF \
   -DOVERRIDE_VERSION=$$(cat $(FEX_SRC)/.git_describe) \
   -DOVERRIDE_HASH=$$(cat $(FEX_SRC)/.git_rev)
 
